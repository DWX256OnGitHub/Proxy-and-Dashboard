# 基础配置
mixed-port: 7890
socks-port: 7891
port: 7892
redir-port: 7893
tproxy-port: 7894
allow-lan: true
bind-address: '*'
mode: rule
log-level: ${LOG_LEVEL}
external-controller: '0.0.0.0:9090'
secret: '${CLASH_SECRET}'

# 网络增强
tun:
  enable: true
  stack: mixed
  dns-hijack:
    - "any:53"
    - "tcp://any:53"
  auto-route: true
  auto-redirect: true
  auto-detect-interface: true

# 代理订阅：直接读取标准 Clash/Mihomo YAML 订阅，无需订阅转换器
proxy-providers:
  ${SUBSCRIBE_NAME}:
    type: http
    url: "${SUBSCRIBE_URL}"
    path: ./providers/main.yaml
    interval: 86400
    health-check:
      enable: true
      url: "https://www.gstatic.com/generate_204"
      interval: 300

